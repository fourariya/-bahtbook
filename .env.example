# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings > API). Never commit .env.local.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Publishable key (sb_publishable_...) or the legacy anon key.
# Do NOT put the secret / service-role key here: the app refuses to start with it,
# and nothing in this project needs it.
SUPABASE_PUBLISHABLE_KEY=

# Public address of this site, used in the sign-up confirmation email link.
# Local development: http://localhost:3000
SITE_URL=http://localhost:3000

# Secret used to sign the short-lived proof that a password recovery link was
# verified. Server only. At least 32 random characters; without it the
# "forgot password" flow stays closed. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Use a different value in every environment and never commit it.
RECOVERY_PROOF_SECRET=

# --- End-to-end tests against real authentication (optional) -----------------
# Use a separate Supabase project for testing, never production.
# Create this user once in that project (Authentication > Users) with email
# confirmation already done, then run: npm run test:e2e
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
# Optional second throwaway user. With it, the API isolation test also proves
# that one account cannot read or change another account's rows.
E2E_USER2_EMAIL=
E2E_USER2_PASSWORD=
# Must be exactly "yes" before the signed-in tests will run. It is your statement
# that SUPABASE_URL above is a test project and not production.
E2E_CONFIRM_TEST_PROJECT=
